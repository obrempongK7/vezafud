APP_NAME=Vezafud
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vezafud_main
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache
CACHE_STORE=redis
CACHE_PREFIX=vezafud_

# Sessions
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue
QUEUE_CONNECTION=redis

# Broadcasts (Laravel Reverb)
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=vezafud_app
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@vezafud.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / Cloudflare R2 (future)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=vezafud-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
PAYSTACK_MERCHANT_EMAIL=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS/OTP)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# JWT
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Media
MEDIA_DISK=public
MAX_UPLOAD_SIZE=51200
IMAGE_QUALITY=85
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400
AVATAR_WIDTH=200
AVATAR_HEIGHT=200

# Elasticsearch (optional)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=

# Search Driver
SCOUT_DRIVER=database

# AI / OpenAI (for recommendations & summaries)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Platform Settings (populated via installer)
PLATFORM_CURRENCY=GHS
PLATFORM_CURRENCY_SYMBOL=GH₵
PLATFORM_TIMEZONE=Africa/Accra
PLATFORM_COUNTRY=GH
PLATFORM_COMMISSION_RATE=10
PLATFORM_DELIVERY_COMMISSION=5
PLATFORM_MIN_ORDER=5.00
PLATFORM_FREE_DELIVERY_THRESHOLD=50.00

# Feature Flags
FEATURE_REELS=true
FEATURE_STORIES=true
FEATURE_MAP=true
FEATURE_WALLET=true
FEATURE_AI_RECOMMENDATIONS=false
